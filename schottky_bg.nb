Cell[CellGroupData[{

Cell[BoxData[
 FormBox["helper", TraditionalForm]], "Subsubsection",
 CellChangeTimes->{{3.9983149105071087`*^9, 
  3.998314912367515*^9}},ExpressionUUID->"ed9de1e2-1cc9-47cd-bbd7-\
2fdd06f81c45"],

Cell[BoxData[
 RowBox[{
  RowBox[{"branchcutarc", "[", 
   RowBox[{"P_", ",", "pp_", ",", "abel_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
     "c", ",", "cc", ",", "r", ",", "\[Phi]1", ",", "\[Phi]2", ",", 
      "abelarg"}], "\[IndentingNewLine]", "}"}], ",", "\t", 
    "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"c", "=", 
      RowBox[{"cc", "/.", 
       RowBox[{"First", "[", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"cc", "-", "P"}], "]"}], "^", "2"}], "==", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"cc", "-", "pp"}], "]"}], "^", "2"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"cc", "-", "P"}], "]"}], "^", "2"}], "==", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"cc", "-", "abel"}], "]"}], "^", "2"}]}]}], "}"}], ",", 
          RowBox[{"{", "cc", "}"}]}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"r", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"c", "-", "P"}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Phi]1", ",", "\[Phi]2"}], "}"}], "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"Arg", "/@", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"P", "-", "c"}], ",", 
          RowBox[{"pp", "-", "c"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"abelarg", "=", 
      RowBox[{"Arg", "[", 
       RowBox[{"abel", "-", "c"}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
     
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Phi]1", ",", "\[Phi]2"}], "}"}], "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"\[Phi]1", "<", "abelarg", "<", "\[Phi]2"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Phi]2", ",", 
          RowBox[{"\[Phi]1", "+", 
           RowBox[{"2", "Pi"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Phi]1", ",", "\[Phi]2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"Circle", "[", 
      RowBox[{
       RowBox[{"ReIm", "[", "c", "]"}], ",", "r", ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]1", ",", "\[Phi]2"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{3.9983151127792253`*^9},
 CellLabel->"In[24]:=",ExpressionUUID->"50e21bb2-1822-4a28-80ae-c2b7fcd1ff7c"]
}, Open  ]],

